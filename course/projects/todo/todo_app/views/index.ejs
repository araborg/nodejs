<%- include("partials/header") %>
<div class="table-container">
	<h2 class="todo-title">Todo List</h2>

	<div>
		<!-- /add-todo is coming 4rm d node route -->
		<a href="/add-todo" class="btn">Add Todo</a>
	</div>

	<br />

	<table>
		<tr>
			<th>Title</th>
			<th>Description</th>
			<th>Created at</th>
			<th>Updated at</th>
			<th>Action</th>
		</tr>

		<tr>
            <!-- todos is coming 4rm: server side
            const todos = await Todo.find({}); 
            -->
            <% for(let i=0; i < todos.length; i++) { %>
                <td><%= todos[i].title %></td>
                <td><%= todos[i].desc %></td>
                <td><%= todos[i].createdAt %></td>
                <td><%= todos[i].updatedAt %></td>
                
                <!-- <td> <%= %></td> -->

                <td>
                    <a href="/update-todo" class="btn">Edit</a>

                    <a href="/delete-todo" class="btn">Delete</a>
                </td>

            </tr>
            <% } %>
	</table>
</div>
<%- include("partials/footer") %>
